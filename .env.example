# .env.example — Template for live trading credentials
# Copy to .env and fill in your real keys
# NEVER commit .env to git (it is gitignored)

# Binance API credentials (Spot trading permissions only)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Safety flag — must be explicitly "true" for live orders
# Default (false/missing) = DRY RUN (logs only, no real orders)
LIVE_TRADING=false

# Total trading capital in USDT (your ACTUAL account size)
TOTAL_CAPITAL_USDT=10000